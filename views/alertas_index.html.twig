{% extends "layout.html.twig" %}

{% block title %}Meus Alertas - Lumen Fintech{% endblock %}

{% block page_title %}Central de Alertas{% endblock %}
{% block page_subtitle %}Gerencie seus lembretes e compromissos importantes{% endblock %}

{% block content %}
    
    <!-- HEADER COM FILTRO E PESQUISA -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                <i class="ph-bold ph-magnifying-glass text-lg"></i>
            </div>
            <input type="text" id="searchAlerta" placeholder="Procurar lembrete..." 
                class="w-full pl-11 pr-4 py-3 bg-white dark:bg-darkCard border border-slate-100 dark:border-darkBorder rounded-2xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm">
        </div>

        <div class="flex-shrink-0">
            <a href="/alertas/cadastrar" class="w-full md:w-auto bg-primary hover:bg-primaryHover text-white px-6 py-3 rounded-2xl font-medium flex items-center justify-center gap-2 transition-all shadow-sm">
                <i class="ph-bold ph-bell-plus text-lg"></i>
                Novo Alerta
            </a>
        </div>
    </div>

    {# Mensagens de Feedback #}
    {% if session_has('success') %}
        <div class="mb-8 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2 font-medium">
            <i class="ph-fill ph-check-circle text-lg"></i>
            {{ session_get('success') }}
        </div>
    {% endif %}

    {# LISTAGEM #}
    {% if alertas is empty %}
        <div class="bg-white dark:bg-darkCard rounded-3xl border border-slate-100 dark:border-darkBorder border-dashed p-12 flex flex-col items-center justify-center text-center">
            <div class="w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4 text-slate-400 dark:text-slate-500">
                <i class="ph-fill ph-bell-slash text-4xl"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">Tudo limpo por aqui</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Você não possui nenhum alerta ativo no momento.</p>
            <a href="/alertas/cadastrar" class="px-6 py-2.5 bg-primary hover:bg-primaryHover text-white rounded-xl font-medium transition-colors">
                Criar Primeiro Alerta
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {% for alerta in alertas %}
                <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder overflow-hidden hover:shadow-md transition-all relative flex flex-col">
                    
                    <div class="p-6 flex-1">
                        <div class="flex justify-between items-start mb-4">
                            <!-- Ícone e Descrição -->
                            <div class="flex gap-4">
                                <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white text-2xl shadow-sm flex-shrink-0" style="background-color: {{ alerta.cor }}">
                                    <i class="ph-fill {{ alerta.icone }}"></i>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-bold text-slate-800 dark:text-white text-lg leading-tight mb-1">{{ alerta.descricao }}</h3>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-500">
                                        {{ alerta.situacao.nome|default('Ativo') }}
                                    </span>
                                </div>
                            </div>

                            <!-- Menu Ações -->
                            <div class="relative dropdown-container">
                                <button onclick="toggleDropdown({{ alerta.id }})" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                                    <i class="ph-bold ph-dots-three-vertical text-2xl"></i>
                                </button>
                                <div id="dropdown-{{ alerta.id }}" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 z-20">
                                    <a href="/alertas/editar/{{ alerta.id }}" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700">
                                        <i class="ph ph-pencil"></i> Editar
                                    </a>
                                    <form action="/alertas/excluir/{{ alerta.id }}" method="POST" onsubmit="return confirm('Excluir este alerta?');">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" class="w-full flex items-center gap-2 px-4 py-3 text-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/10 text-left">
                                            <i class="ph ph-trash"></i> Excluir
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Datas e Prazos -->
                        <div class="space-y-3 mt-6">
                            <div class="flex items-center gap-3 text-sm">
                                <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-600 flex items-center justify-center">
                                    <i class="ph-bold ph-clock"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] text-slate-400 uppercase font-bold leading-none">Avisar em</p>
                                    <p class="font-semibold text-slate-700 dark:text-slate-300">{{ alerta.data_alerta|date("d/m/Y") }}</p>
                                </div>
                            </div>

                            {% if alerta.data_vencimento %}
                            <div class="flex items-center gap-3 text-sm">
                                <div class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-600 flex items-center justify-center">
                                    <i class="ph-bold ph-calendar-x"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] text-slate-400 uppercase font-bold leading-none">Vencimento</p>
                                    <p class="font-semibold text-slate-700 dark:text-slate-300">{{ alerta.data_vencimento|date("d/m/Y") }}</p>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Footer: Status de Urgência -->
                    <div class="px-6 py-4 bg-slate-50/50 dark:bg-slate-800/30 border-t border-slate-100 dark:border-darkBorder">
                        {% set dias_restantes = (alerta.data_vencimento|date('U') - "now"|date('U')) / 86400 %}
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-medium text-slate-500 italic">
                                Criado em {{ alerta.created_at|date("d/m/y") }}
                            </span>
                            
                            {% if alerta.data_vencimento %}
                                {% if dias_restantes < 0 %}
                                    <span class="text-[10px] font-bold text-rose-600 bg-rose-100 dark:bg-rose-500/20 px-2 py-1 rounded-md uppercase">Vencido</span>
                                {% elseif dias_restantes <= 3 %}
                                    <span class="text-[10px] font-bold text-amber-600 bg-amber-100 dark:bg-amber-500/20 px-2 py-1 rounded-md uppercase">Urgente</span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <script>
        function toggleDropdown(id) {
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
                if(el.id !== `dropdown-${id}`) el.classList.add('hidden');
            });
            const dropdown = document.getElementById(`dropdown-${id}`);
            dropdown.classList.toggle('hidden');
        }

        // Filtro de pesquisa simples
        document.getElementById('searchAlerta').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.grid > div').forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(term) ? 'flex' : 'none';
            });
        });

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-container')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
            }
        });
    </script>
{% endblock %}