{% extends "layout.html.twig" %}

{% block title %}Minhas Caixinhas - Lumen Fintech{% endblock %}

{% block page_title %}Caixinhas{% endblock %}
{% block page_subtitle %}Acompanhe o progresso dos seus objetivos financeiros{% endblock %}

{% block content %}
    
    <!-- HEADER DA PÁGINA (Total Acumulado e Botão Nova) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        
        <!-- Card de Total Acumulado -->
        <div class="bg-primary dark:bg-indigo-600 rounded-3xl p-6 shadow-sm flex items-center justify-between text-white flex-1 relative overflow-hidden group">
            <div class="relative z-10">
                <p class="text-indigo-100 text-sm font-medium mb-1">Total Guardado (Todas as Caixinhas)</p>
                <h2 class="text-3xl sm:text-4xl font-bold">R$ {{ total_acumulado|number_format(2, ',', '.') }}</h2>
            </div>
            <div class="relative z-10 w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm hidden sm:flex">
                <i class="ph-fill ph-piggy-bank text-3xl"></i>
            </div>
            <i class="ph-fill ph-coins absolute -right-6 -bottom-6 text-8xl opacity-10 group-hover:opacity-20 transition-opacity"></i>
        </div>

        <!-- Botão Nova Caixinha -->
        <div class="flex-shrink-0">
            <a href="/caixinhas/cadastrar" class="w-full md:w-auto bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 text-white px-6 py-4 md:py-6 rounded-3xl font-medium flex items-center justify-center gap-2 transition-all shadow-sm">
                <i class="ph-bold ph-plus text-xl"></i>
                Nova Caixinha
            </a>
        </div>
    </div>

    {# Alertas de Sucesso/Erro #}
    {% if session_has('success') %}
        <div class="mb-8 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2 font-medium shadow-sm">
            <i class="ph-fill ph-check-circle text-lg"></i>
            {{ session_get('success') }}
        </div>
    {% endif %}

    {% if session_has('errors') %}
        <div class="mb-8 p-4 rounded-2xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm flex items-center gap-2 font-medium shadow-sm">
            <i class="ph-fill ph-warning-circle text-lg"></i>
            {{ session_get('errors')[0] }}
        </div>
    {% endif %}

    {# Listagem de Caixinhas #}
    {% if caixinhas is empty %}
        <!-- Empty State -->
        <div class="bg-white dark:bg-darkCard rounded-3xl border border-slate-100 dark:border-darkBorder border-dashed p-12 flex flex-col items-center justify-center text-center">
            <div class="w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4 text-slate-400 dark:text-slate-500">
                <i class="ph-fill ph-package text-4xl"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">Nenhuma caixinha criada</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Comece a poupar criando o seu primeiro objetivo financeiro.</p>
            <a href="/caixinhas/cadastrar" class="px-6 py-2.5 bg-primary hover:bg-primaryHover text-white rounded-xl font-medium transition-colors flex items-center gap-2">
                <i class="ph-bold ph-plus"></i> Criar Primeira Caixinha
            </a>
        </div>
    {% else %}
        <!-- Grid de Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for caixinha in caixinhas %}
                <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder overflow-hidden flex flex-col hover:shadow-md transition-shadow relative group">
                    
                    <!-- Faixa de Cor Superior -->
                    <div class="h-2 w-full" style="background-color: {{ caixinha.cor|default('#4f46e5') }}"></div>
                    
                    <div class="p-6 flex-1 flex flex-col">
                        <!-- Header do Card -->
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-bold text-lg text-slate-800 dark:text-white truncate pr-4" title="{{ caixinha.nome }}">{{ caixinha.nome }}</h3>
                            
                            <!-- Dropdown Menu de Opções -->
                            <div class="relative dropdown-container">
                                <button onclick="toggleDropdown({{ caixinha.id }})" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1">
                                    <i class="ph-bold ph-dots-three-vertical text-xl"></i>
                                </button>
                                
                                <div id="dropdown-{{ caixinha.id }}" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 z-20 overflow-hidden">
                                {# NOVO LINK: VER DETALHES #}
                                    <a href="/caixinhas/show/{{ caixinha.id }}" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors border-b border-slate-50 dark:border-slate-700">
                                        <i class="ph ph-eye"></i> Ver Extrato
                                    </a>
                                    <a href="/caixinhas/editar/{{ caixinha.id }}" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                                        <i class="ph ph-pencil-simple"></i> Editar Caixinha
                                    </a>
                                    <form action="/caixinhas/excluir/{{ caixinha.id }}" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta caixinha?');" class="m-0">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" class="w-full flex items-center gap-2 px-4 py-3 text-sm text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors text-left">
                                            <i class="ph ph-trash"></i> Excluir Caixinha
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Descrição -->
                        <p class="text-sm text-slate-500 dark:text-slate-400 mb-6 flex-1 line-clamp-2" title="{{ caixinha.descricao }}">
                            {{ caixinha.descricao|default('Sem descrição detalhada') }}
                        </p>

                        {# EXIBIÇÃO CONDICIONAL DA DATA LIMITE #}
                        {% if caixinha.data_limite and caixinha.data_limite != '0000-00-00' %}
                        <div class="mb-4 flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                            <i class="ph-bold ph-calendar-blank text-sm"></i>
                            <span>Prazo: {{ caixinha.data_limite|date('d/m/Y') }}</span>
                        </div>
                        {% endif %}
                        
                        <!-- Valores Guardado vs Meta -->
                        <div class="flex justify-between items-end mb-3">
                            <div>
                                <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-0.5">Guardado</p>
                                <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400 leading-none">R$ {{ caixinha.valor_atual|number_format(2, ',', '.') }}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-0.5">Meta</p>
                                <p class="text-sm font-semibold text-slate-700 dark:text-slate-300 leading-none">R$ {{ caixinha.valor_meta|number_format(2, ',', '.') }}</p>
                            </div>
                        </div>

                        <!-- Barra de Progresso -->
                        <div class="w-full bg-slate-100 dark:bg-slate-700/50 rounded-full h-2 mb-1.5 overflow-hidden">
                            <div class="h-2 rounded-full transition-all duration-1000 ease-out" style="width: {{ caixinha.porcentagem }}%; background-color: {{ caixinha.cor|default('#4f46e5') }}"></div>
                        </div>
                        <p class="text-right text-xs font-bold" style="color: {{ caixinha.cor|default('#4f46e5') }}">{{ caixinha.porcentagem }}%</p>
                    </div>
                    
                    <!-- Footer / Botão Movimentar -->
                    <div class="p-4 border-t border-slate-50 dark:border-darkBorder bg-slate-50/50 dark:bg-slate-800/20">
                        <button onclick="abrirModalMovimentacao({{ caixinha.id }}, '{{ caixinha.nome }}')" class="w-full py-2.5 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition-colors border border-slate-200 dark:border-slate-700 bg-white dark:bg-darkCard text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-primary dark:hover:text-indigo-400 shadow-sm">
                            <i class="ph-bold ph-arrows-down-up text-lg"></i> Movimentar Saldo
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <!-- ========================================== -->
    <!-- MODAL DE MOVIMENTAÇÃO (TAILWIND + VANILLA JS) -->
    <!-- ========================================== -->
    <div id="modalMovimentacao" class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <!-- Fundo escuro (Overlay) -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="fecharModalMovimentacao()"></div>
        
        <!-- Conteúdo do Modal -->
        <div class="bg-white dark:bg-darkCard w-full max-w-md rounded-3xl shadow-xl z-10 m-4 overflow-hidden transform scale-95 transition-transform duration-300" id="modalContent">
            
            <div class="flex items-center justify-between p-6 border-b border-slate-100 dark:border-darkBorder">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="ph-fill ph-arrows-down-up text-primary dark:text-indigo-400" id="icone_modal_header"></i> Movimentar Saldo
                </h3>
                <button onclick="fecharModalMovimentacao()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                    <i class="ph-bold ph-x text-xl"></i>
                </button>
            </div>

            <!-- Formulário adaptado para movimentação genérica -->
            <form action="/caixinhas/movimentar" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <div class="p-6">
                    <input type="hidden" name="caixinha_id" id="modal_caixinha_id">
                    
                    <div class="text-center mb-6">
                        <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Movimentando na caixinha:</p>
                        <h4 class="text-xl font-bold text-primary dark:text-indigo-400" id="modal_caixinha_nome">Nome da Caixinha</h4>
                    </div>

                    <!-- Alternador de Tipo (Guardar vs Retirar) -->
                    <div class="flex p-1 mb-6 bg-slate-100 dark:bg-slate-800 rounded-xl">
                        <label class="flex-1 text-center cursor-pointer relative">
                            <input type="radio" name="tipo_movimentacao" value="entrada" class="peer sr-only" checked onchange="atualizarVisualModal(this.value)">
                            <div class="py-2 px-4 rounded-lg text-sm font-bold text-slate-500 dark:text-slate-400 peer-checked:bg-white dark:peer-checked:bg-slate-700 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-400 peer-checked:shadow-sm transition-all flex items-center justify-center gap-2">
                                <i class="ph-bold ph-trend-up"></i> Guardar
                            </div>
                        </label>
                        <label class="flex-1 text-center cursor-pointer relative">
                            <input type="radio" name="tipo_movimentacao" value="saida" class="peer sr-only" onchange="atualizarVisualModal(this.value)">
                            <div class="py-2 px-4 rounded-lg text-sm font-bold text-slate-500 dark:text-slate-400 peer-checked:bg-white dark:peer-checked:bg-slate-700 peer-checked:text-rose-600 dark:peer-checked:text-rose-400 peer-checked:shadow-sm transition-all flex items-center justify-center gap-2">
                                <i class="ph-bold ph-trend-down"></i> Retirar
                            </div>
                        </label>
                    </div>

                    <div>
                        <label for="valor_movimentacao" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Valor da movimentação</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 font-bold">
                                R$
                            </div>
                            <!-- A cor da borda deste input é controlada pelo JS dependendo da opção escolhida -->
                            <input type="text" id="valor_movimentacao" name="valor" required placeholder="0,00" onkeyup="formatarMoeda(this)"
                                class="w-full pl-12 pr-4 py-4 text-xl font-bold bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all">
                        </div>
                    </div>
                </div>

                <div class="p-6 bg-slate-50 dark:bg-slate-800/50 flex gap-3 border-t border-slate-100 dark:border-darkBorder">
                    <button type="button" onclick="fecharModalMovimentacao()" class="flex-1 py-3 rounded-xl font-medium text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors">
                        Cancelar
                    </button>
                    <!-- A cor deste botão muda dependendo se é Entrada ou Saída via JS -->
                    <button type="submit" id="btn_confirmar_modal" class="flex-1 py-3 rounded-xl font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-sm">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPTS DE INTERAÇÃO -->
    <script>
        // 1. Controle dos Dropdowns (Opções dos Cards)
        function toggleDropdown(id) {
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
                if(el.id !== `dropdown-${id}`) el.classList.add('hidden');
            });
            const dropdown = document.getElementById(`dropdown-${id}`);
            dropdown.classList.toggle('hidden');
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-container')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
            }
        });

        // 2. Controle do Modal de Movimentação
        const modal = document.getElementById('modalMovimentacao');
        const modalContent = document.getElementById('modalContent');
        const inputValor = document.getElementById('valor_movimentacao');
        const btnConfirmar = document.getElementById('btn_confirmar_modal');

        function abrirModalMovimentacao(id, nome) {
            document.getElementById('modal_caixinha_id').value = id;
            document.getElementById('modal_caixinha_nome').textContent = nome;
            inputValor.value = ''; // Limpa o campo
            
            // Força a opção "Guardar" (entrada) como padrão ao abrir
            document.querySelector('input[name="tipo_movimentacao"][value="entrada"]').checked = true;
            atualizarVisualModal('entrada');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
                inputValor.focus();
            }, 10);
        }

        function fecharModalMovimentacao() {
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // 3. Atualiza cores do Modal dependendo se é Guardar ou Retirar
        function atualizarVisualModal(tipo) {
            if (tipo === 'entrada') {
                // Tema Verde para Depósitos
                inputValor.classList.remove('focus:ring-rose-500/20', 'focus:border-rose-500');
                inputValor.classList.add('focus:ring-emerald-500/20', 'focus:border-emerald-500');
                
                btnConfirmar.classList.remove('bg-rose-600', 'hover:bg-rose-700');
                btnConfirmar.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
                btnConfirmar.innerHTML = '<i class="ph-bold ph-plus-circle"></i> Confirmar Depósito';
            } else {
                // Tema Vermelho para Saques
                inputValor.classList.remove('focus:ring-emerald-500/20', 'focus:border-emerald-500');
                inputValor.classList.add('focus:ring-rose-500/20', 'focus:border-rose-500');
                
                btnConfirmar.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
                btnConfirmar.classList.add('bg-rose-600', 'hover:bg-rose-700');
                btnConfirmar.innerHTML = '<i class="ph-bold ph-minus-circle"></i> Confirmar Saque';
            }
        }

        // 4. Máscara de Moeda (Formatador BR)
        function formatarMoeda(i) {
            var v = i.value.replace(/\D/g,'');
            v = (v/100).toFixed(2) + '';
            v = v.replace(".", ",");
            v = v.replace(/(\d)(\d{3})(\d{3}),/g, "$1.$2.$3,");
            v = v.replace(/(\d)(\d{3}),/g, "$1.$2,");
            i.value = v;
        }
    </script>
{% endblock %}