{% extends "layout.html.twig" %}

{# Define se é modo edição ou cadastro baseado na existência do ID #}
{% set modo = cartao.id ? 'Editar' : 'Adicionar' %}

{% block title %}{{ modo }} Cartão de Crédito - Lumen Fintech{% endblock %}

{% block page_title %}Cartões de Crédito{% endblock %}
{% block page_subtitle %}
    {{ modo == 'Editar' ? 'Atualizar dados do cartão' : 'Registre um novo cartão para controlar os seus limites' }}
{% endblock %}

{% block content %}
    <div class="max-w-3xl mx-auto">
        <!-- Card do Formulário -->
        <div class="bg-white dark:bg-darkCard p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            
            <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-darkBorder pb-4">
                <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-500/10 text-purple-500 dark:text-purple-400 flex items-center justify-center">
                    <i class="ph-bold ph-credit-card text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-slate-800 dark:text-white">Dados do Registro</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        {{ modo == 'Editar' ? 'Altere as informações necessárias abaixo.' : 'Preencha os dados para criar um novo Cartão de Crédito!' }}
                    </p>
                </div>
            </div>

            {# Alertas de Erro #}
            {% if session_has('errors') %}
                <div class="mb-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm">
                    <div class="flex items-center gap-2 font-bold mb-1">
                        <i class="ph-fill ph-warning-circle text-lg"></i>
                        <span>Verifique os erros abaixo:</span>
                    </div>
                    <ul class="list-disc list-inside ml-2">
                        {% for erro in session_get('errors') %}
                            <li>{{ erro }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form action="{{ modo == 'Editar' ? '/cartoes/atualizar/' ~ cartao.id : '/cartoes/criar' }}" 
                  method="POST" id="formCartao" class="space-y-6">
                
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Nome do Cartão -->
                    <div class="md:col-span-2">
                        <label for="nome" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Nome do Cartão <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-identification-card text-lg"></i>
                            </div>
                            <input type="text" id="nome" name="nome" value="{{ old['nome'] ?? cartao.nome ?? '' }}" required
                                class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-slate-400"
                                placeholder="Ex: Nubank, Itaú Click, Inter Mastercard">
                        </div>
                    </div>

                    <!-- Limite Total -->
                    <div class="md:col-span-2">
                        <label for="limite" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Limite Total (R$) <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 font-medium">
                                R$
                            </div>
                            <input type="text" id="limite" name="limite" 
                                value="{{ old['limite'] ?? (cartao.limite ? cartao.limite|number_format(2, ',', '.') : '') }}" 
                                required onkeyup="formatarMoeda(this)"
                                class="w-full pl-10 pr-4 py-2.5 font-semibold bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-slate-400"
                                placeholder="0,00">
                        </div>
                    </div>

                    <!-- Dia de Fechamento -->
                    <div>
                        <label for="dia_fechamento" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Dia de Fechamento <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-calendar-x text-lg"></i>
                            </div>
                            <input type="number" min="1" max="31" id="dia_fechamento" name="dia_fechamento" 
                                value="{{ old['dia_fechamento'] ?? cartao.dia_fechamento ?? '' }}" required
                                class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-slate-400">
                        </div>
                        <p class="text-[10px] text-slate-500 mt-1">Dia em que a fatura vira.</p>
                    </div>

                    <!-- Dia de Vencimento -->
                    <div>
                        <label for="dia_vencimento" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Dia de Vencimento <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-calendar-check text-lg"></i>
                            </div>
                            <input type="number" min="1" max="31" id="dia_vencimento" name="dia_vencimento" 
                                value="{{ old['dia_vencimento'] ?? cartao.dia_vencimento ?? '' }}" required
                                class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                        </div>
                    </div>

                    <!-- Cor do Cartão -->
                    <div class="md:col-span-2">
                        <label for="cor" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Cor Principal do Cartão <span class="text-rose-500">*</span></label>
                        <div class="relative flex items-center gap-3">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-palette text-lg"></i>
                            </div>
                            <input type="color" id="cor" name="cor" value="{{ old['cor'] ?? cartao.cor ?? '#8A05BE' }}" required
                                class="h-12 w-full pl-10 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer p-1 transition-all">
                        </div>
                        <p class="text-xs text-slate-500 mt-1">Escolha a cor da instituição para facilitar a identificação visual.</p>
                    </div>

                    {# <!-- Situação (Apenas no Modo Editar) -->
                    {% if modo == 'Editar' %}
                    <div class="md:col-span-2">
                        <label for="situacao_id" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Situação do Cartão</label>
                        <select name="situacao_id" id="situacao_id" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                            {% for situacao in situacoes %}
                                <option value="{{ situacao.id }}" {{ (old['situacao_id'] ?? cartao.situacao_id) == situacao.id ? 'selected' : '' }}>
                                    {{ situacao.nome }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %} #}
                </div>

                <!-- Botões de Ação -->
                <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-6 border-t border-slate-100 dark:border-darkBorder mt-8">
                    <a href="/cartoes" class="px-6 py-2.5 rounded-xl font-medium text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors text-center inline-block">
                        Cancelar
                    </a>
                    <button type="submit" class="px-6 py-2.5 rounded-xl font-medium text-white bg-primary hover:bg-primaryHover shadow-sm transition-colors flex justify-center items-center gap-2">
                        <i class="ph-bold ph-floppy-disk text-lg"></i> {{ modo == 'Editar' ? 'Atualizar Cartão' : 'Salvar Cartão' }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function formatarMoeda(i) {
            var v = i.value.replace(/\D/g,'');
            v = (v/100).toFixed(2) + '';
            v = v.replace(".", ",");
            v = v.replace(/(\d)(\d{3})(\d{3}),/g, "$1.$2.$3,");
            v = v.replace(/(\d)(\d{3}),/g, "$1.$2,");
            i.value = v;
        }
    </script>
{% endblock %}