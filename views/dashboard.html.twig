{% extends "layout.html.twig" %}

{% block title %}Dashboard - Lumen Fintech{% endblock %}

{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Resumo financeiro de <span class="font-semibold text-primary dark:text-indigo-400"> {{ mes_atual }}</span>{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- Saldo / Balanço do Mês -->
        <div class="
            {% if saldo_mensal > 0 %}
                bg-primary dark:bg-indigo-600
            {% elseif saldo_mensal < 0 %}
                bg-rose-500 dark:bg-rose-600
            {% else %}
                bg-amber-500 dark:bg-amber-600
            {% endif %}
            p-6 rounded-3xl shadow-md border-transparent flex flex-col justify-between relative overflow-hidden group text-white
        ">
            
            <div class="flex justify-between items-start mb-4 relative z-10">
                
                <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center">
                    <i class="ph-fill ph-scales text-2xl"></i>
                </div>

                <span class="bg-white/20 text-white text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1 backdrop-blur-sm">
                    
                    {% if saldo_mensal > 0 %}
                        <i class="ph-bold ph-trend-up"></i> Positivo
                    {% elseif saldo_mensal < 0 %}
                        <i class="ph-bold ph-trend-down"></i> Negativo
                    {% else %}
                        <i class="ph-bold ph-minus"></i> Neutro
                    {% endif %}

                </span>
            </div>

            <div class="relative z-10">
                
                <p class="
                    text-sm font-medium mb-1

                    {% if saldo_mensal > 0 %}
                        text-indigo-100
                    {% elseif saldo_mensal < 0 %}
                        text-rose-100
                    {% else %}
                        text-amber-100
                    {% endif %}
                ">
                    Resultado do Mês
                </p>

                <h2 class="text-2xl sm:text-3xl font-bold">
                    R$ {{ saldo_mensal|number_format(2, ',', '.') }}
                </h2>

                <p class="
                    text-xs mt-2

                    {% if saldo_mensal > 0 %}
                        text-indigo-200
                    {% elseif saldo_mensal < 0 %}
                        text-rose-200
                    {% else %}
                        text-amber-200
                    {% endif %}
                ">
                    Diferença Receitas x Despesas
                </p>

            </div>

            <div class="absolute -right-6 -bottom-6 opacity-10 group-hover:opacity-20 transition-opacity">
                <i class="ph-fill ph-coins text-9xl"></i>
            </div>
        </div>

        <!-- Receitas -->
        <div class="bg-white dark:bg-darkCard p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder flex flex-col justify-between">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 flex items-center justify-center">
                    <i class="ph-bold ph-arrow-down-left text-xl"></i>
                </div>
                <div class="text-right">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Total a Receber</p>
                    <h3 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white">R$ {{ total_receber|number_format(2, ',', '.') }}</h3>
                </div>
            </div>
            
            <div class="mt-4">
                <div class="flex flex-col sm:flex-row sm:justify-between text-xs mb-1.5 gap-1 sm:gap-0">
                    <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                        <i class="ph-fill ph-check-circle"></i> Recebido: R$ {{ total_recebido|number_format(2, ',', '.') }}
                    </span>
                    <span class="text-slate-400 dark:text-slate-500 flex items-center gap-1">
                        <i class="ph-fill ph-clock"></i> Falta: R$ {{ total_aberto_receber|number_format(2, ',', '.') }}
                    </span>
                </div>
                <div class="w-full bg-slate-100 dark:bg-slate-700/50 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-emerald-500 h-2.5 rounded-full" style="width: {{porcentagem_recebidas}}%"></div>
                </div>
            </div>
        </div>

        <!-- Despesas -->
        <div class="bg-white dark:bg-darkCard p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder flex flex-col justify-between">
            <div class="flex justify-between items-start mb-2">
                <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-500 dark:text-rose-400 flex items-center justify-center">
                    <i class="ph-bold ph-arrow-up-right text-xl"></i>
                </div>
                <div class="text-right">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Total a Pagar</p>
                    <h3 class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-white">R$ {{ total_pagar|number_format(2, ',', '.') }}</h3>
                </div>
            </div>
            
            <div class="mt-4">
                <div class="flex flex-col sm:flex-row sm:justify-between text-xs mb-1.5 gap-1 sm:gap-0">
                    <span class="text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                        <i class="ph-fill ph-check-circle"></i> Pago: R$ {{ total_baixado|number_format(2, ',', '.') }}
                    </span>
                    <span class="text-slate-400 dark:text-slate-500 flex items-center gap-1">
                        <i class="ph-fill ph-clock"></i> Falta:   {{ total_aberto|number_format(2, ',', '.') }}
                    </span>
                </div>
                <div class="w-full bg-slate-100 dark:bg-slate-700/50 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-rose-500 h-2.5 rounded-full" style="width: {{ porcentagem_pagas }}%"></div>
                </div>
            </div>
        </div>

        <!-- Saldo Geral Contas -->
        <div class="bg-white dark:bg-darkCard p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-500/10 text-blue-500 dark:text-blue-400 flex items-center justify-center">
                    <i class="ph-fill ph-bank text-xl"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Saldo em Contas</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500">Hoje</p>
                </div>
            </div>
            <div>
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 dark:text-white">
                R$ {{ saldo_em_contas|number_format(2, ',', '.') }}
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1"></p>
            </div>
        </div>
    </div>

    <!-- MEUS CARTÕES -->
    <div>
        <div class="flex justify-between items-end mb-4 px-1">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">Meus Cartões</h3>
            <a href="#" class="text-sm font-semibold text-primary dark:text-indigo-400 hover:underline">Ver faturas</a>
        </div>
        
        <div class="flex overflow-x-auto pb-4 snap-x snap-mandatory hide-scroll gap-4 sm:gap-6 md:grid md:grid-cols-3">
            {% for cartao in dados_cartao %}
                {# <pre>{{ cartao|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre> #}
                <div class="min-w-[280px] md:min-w-0 snap-center bg-[{{cartao.cor}}] p-6 rounded-3xl shadow-md relative overflow-hidden group text-white">

                    <div class="flex justify-between items-center mb-6 relative z-10">
                        <span class="font-bold text-lg tracking-wider">
                            {{ cartao.nome }}
                        </span>

                        <i class="ph-bold ph-contactless-payment text-2xl opacity-70"></i>
                    </div>

                    <div class="relative z-10">

                        <p class="text-purple-200 text-xs mb-1">
                            Fatura atual
                            <span class="font-semibold text-white">
                                (Vence dia {{ cartao.dia_vencimento }})
                            </span>
                        </p>

                        <h3 class="text-2xl font-bold">
                            R$ {{ cartao.fatura_atual|number_format(2, ',', '.') }}
                        </h3>

                        <div class="mt-4">
                            <div class="flex justify-between text-xs text-purple-200 mb-1">

                                <span>Fechamento</span>

                                <span class="font-bold text-white">
                                    Dia {{ cartao.dia_fechamento }}
                                </span>

                            </div>
                        </div>

                    </div>

                    <i class="ph-fill ph-credit-card absolute -right-6 -bottom-6 text-8xl opacity-10 transform -rotate-12 group-hover:scale-110 transition-transform"></i>

                </div>

                {% endfor %}
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {{ include('fluxo_caixa_component.html.twig') }}
        
        {# <!-- FLUXO DE CAIXA -->
        <div class="lg:col-span-2 bg-white dark:bg-darkCard p-4 sm:p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white">Fluxo de Caixa</h3>
                <select class="w-full sm:w-auto bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-sm font-medium text-slate-600 dark:text-slate-300 py-2 px-4 rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    <option>Mês Atual</option>
                    <option>Últimos 3 meses</option>
                    <option selected>Últimos 6 meses</option>
                </select>
            </div>
            <div class="h-64 flex items-center justify-center border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-2xl bg-slate-50/50 dark:bg-slate-800/20">
                <div class="text-center p-4">
                    <i class="ph ph-chart-bar text-4xl text-slate-300 dark:text-slate-600 mb-2"></i>
                    <p class="text-sm font-medium text-slate-400 dark:text-slate-500">Gráfico será renderizado aqui</p>
                </div>
            </div>
        </div> #}

        <!-- TOP CATEGORIAS -->
        <div class="bg-white dark:bg-darkCard p-4 sm:p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder flex flex-col">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-6">Onde gastei mais?</h3>

            <div class="space-y-6 flex-1">
                {% for categoria in gastos_categoria %}
                {# <pre>
                {{ categoria|json_encode(constant('JSON_PRETTY_PRINT')) }}
                 </pre> #}
                <div>
                    <div class="flex justify-between text-sm mb-2">
                        <span class="flex items-center gap-2 font-medium text-slate-700 dark:text-slate-300">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: {{ categoria.cor }}20; color: {{ categoria.cor }};">
                                <i class="ph-fill {{ categoria.icone }}"></i>
                            </div>
                            {{ categoria.nome }}
                        </span>

                        <span class="font-bold dark:text-slate-200 mt-1">
                            R$ {{ categoria.total|number_format(2, ',', '.') }}
                        </span>
                    </div>

                    <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
                        <div class="h-2 rounded-full" style="width: {{categoria.porcentagem}}%; background-color: {{ categoria.cor }};"></div>

                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- TRANSAÇÕES RECENTES -->
    <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder overflow-hidden">
        <div class="p-4 sm:p-6 border-b border-slate-100 dark:border-darkBorder flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
            <h3 class="text-lg font-bold text-slate-800 dark:text-white">Transações Recentes</h3>
            <a href="/lancamentos" class="text-sm font-semibold text-primary dark:text-indigo-400 hover:text-primaryHover transition-colors flex items-center gap-1 w-max">
                Ver extrato completo <i class="ph-bold ph-arrow-right"></i>
            </a>
        </div>
        
        <div class="overflow-x-auto w-full pb-2">
            <table class="w-full text-left border-collapse whitespace-nowrap">
                <thead>
                    <tr class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-400 dark:text-slate-500 text-xs uppercase tracking-wider border-b border-slate-100 dark:border-darkBorder">
                        <th class="p-4 font-semibold rounded-tl-xl">Descrição</th>
                        <th class="p-4 font-semibold">Fornecedor / Cliente</th>
                        <th class="p-4 font-semibold">Categoria</th>
                        <th class="p-4 font-semibold">Status</th>
                        <th class="p-4 font-semibold">Venc.</th>
                        <th class="p-4 font-semibold">Pagam.</th>
                        <th class="p-4 font-semibold text-right rounded-tr-xl">Valor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
                    <!-- Item 1 -->
                    {% for ultimo in ultimos_lancamentos %}
                    {# <pre>
                        {{ ultimo|json_encode(constant('JSON_PRETTY_PRINT')) }}
                    </pre> #}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors group">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full flex-shrink-0 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400">
                                    <i class="ph-bold {{ultimo.icone}} text-lg"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-slate-800 dark:text-slate-200">{{ultimo.descricao}}</p>
                                    <p class="text-xs text-slate-400 dark:text-slate-500 flex items-center gap-1">

                                        {% if ultimo.forma_pagamento == 'pix' %}
                                            <i class="ph-fill ph-pix-logo text-emerald-500"></i>
                                            Pix

                                        {% elseif ultimo.forma_pagamento == 'dinheiro' %}
                                            <i class="ph-fill ph-money text-green-500"></i>
                                            Dinheiro

                                        {% elseif ultimo.forma_pagamento == 'cartao_credito' %}
                                            <i class="ph-fill ph-credit-card text-violet-500"></i>
                                            Cartão de Crédito

                                        {% elseif ultimo.forma_pagamento == 'boleto' %}
                                            <i class="ph-fill ph-barcode text-amber-500"></i>
                                            Boleto

                                        {% elseif ultimo.forma_pagamento == 'transferencia' %}
                                            <i class="ph-fill ph-bank text-blue-500"></i>
                                            Transferência

                                        {% else %}
                                            <i class="ph-fill ph-wallet"></i>
                                            {{ ultimo.forma_pagamento }}
                                        {% endif %}

                                    </p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4"><span class="text-sm font-medium text-slate-700 dark:text-slate-300">{{ultimo.fornecedor_nome}}</span></td>
                        <td class="p-4"><span class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-lg text-xs font-medium">{{ultimo.categoria_nome}}</span></td>

                        {% if ultimo.status == 'pago' %}
                        <td class="p-4"><span class="flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400"><i class="ph-fill ph-check-circle"></i> {{ultimo.status}}</span></td>
                        {% else %}
                        <td class="p-4"><span class="flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-yellow-400"><i class="ph-fill ph-clock"></i> {{ultimo.status}}</span></td>
                        {% endif %} 
                        <td class="p-4 text-sm text-slate-500 dark:text-slate-400">{{ultimo.data_vencimento|date('d/m/Y')}}</td>
                        <td class="p-4 text-sm text-slate-500 dark:text-slate-400">{{ultimo.data_pagamento|date('d/m/Y')}}</td>
                        {% if ultimo.tipo == 'entrada' %}
                            <td class="p-4 text-right">
                                <span class="font-bold text-emerald-600 dark:text-emerald-400">
                                    + R$ {{ ultimo.valor|number_format(2, ',', '.') }}
                                </span>
                            </td>
                        {% else %}
                            <td class="p-4 text-right">
                                <span class="font-bold text-red-600 dark:text-red-400">
                                    - R$ {{ ultimo.valor|number_format(2, ',', '.') }}
                                </span>
                            </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}