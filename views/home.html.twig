    </div>
  </div>
</section>

<!-- PRICING -->
<section id="planos">
  <div class="reveal" style="text-align:center">
    <div class="section-badge">Planos</div>
    <h2 class="section-title">Um preço simples, <br>tudo incluído</h2>
    <p class="section-sub" style="margin:0 auto">Sem surpresas, sem taxas ocultas. Acesso completo a todas as funcionalidades.</p>
  </div>

  <div style="display:flex;justify-content:center;margin-top:3rem">
    <div class="reveal" style="background:#1e293b;border:2px solid #6366f1;border-radius:28px;padding:3rem;max-width:420px;width:100%;text-align:center;position:relative">

      <!-- Badge destaque -->
      <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:#6366f1;color:#fff;font-size:12px;font-weight:600;padding:5px 20px;border-radius:100px;white-space:nowrap">
        Acesso completo
      </div>

