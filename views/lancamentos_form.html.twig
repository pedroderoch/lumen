{% extends "layout.html.twig" %}

{% block title %}{{ lancamento.id ? 'Editar' : 'Novo' }} Lançamento{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto">
    <form action="{{ lancamento.id ? '/lancamentos/atualizar/' ~ lancamento.id : '/lancamentos/criar' }}" method="POST" class="space-y-6">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        
        <div class="bg-white dark:bg-darkCard p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            
            <!-- SELETOR DE TIPO (RADIO PERSONALIZADO) -->
            <div class="flex justify-center mb-10">
                <div class="inline-flex bg-slate-100 dark:bg-slate-800 p-1.5 rounded-2xl">
                    {% set tipo_atual = session_get('old').tipo ?? lancamento.tipo ?? 'saida' %}
                    <label class="px-8 py-3 rounded-xl cursor-pointer font-bold text-sm transition-all has-[:checked]:bg-white dark:has-[:checked]:bg-slate-700 {{ tipo_atual == 'saida' ? 'text-rose-600' : 'text-slate-500' }}">
                        <input type="radio" name="tipo" value="saida" class="sr-only" {{ tipo_atual == 'saida' ? 'checked' : '' }} onchange="filtrarCategorias()">
                        Despesa
                    </label>
                    <label class="px-8 py-3 rounded-xl cursor-pointer font-bold text-sm transition-all has-[:checked]:bg-white dark:has-[:checked]:bg-slate-700 {{ tipo_atual == 'entrada' ? 'text-emerald-600' : 'text-slate-500' }}">
                        <input type="radio" name="tipo" value="entrada" class="sr-only" {{ tipo_atual == 'entrada' ? 'checked' : '' }} onchange="filtrarCategorias()">
                        Receita
                    </label>
                </div>
            </div>

            <!-- GRID PRINCIPAL -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Descrição -->
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Descrição do Lançamento *</label>
                    <input type="text" name="descricao" value="{{ session_get('old').descricao ?? lancamento.descricao ?? '' }}" required 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                </div>

                <!-- Favorecido -->
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Favorecido (Pessoa ou Empresa) *</label>
                    <select name="fornecedor_id" required 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        <option value="">Selecione quem pagou ou recebeu...</option>
                        {% for f in fornecedores %}
                            <option value="{{ f.id }}" {{ (session_get('old').fornecedor_id ?? lancamento.fornecedor_id) == f.id ? 'selected' : '' }}>{{ f.nome }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Valor -->
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Valor Total (R$) *</label>
                    {% set v_f = session_get('old').valor ?? (lancamento.valor ? lancamento.valor|number_format(2, ',', '.') : '') %}
                    <input type="text" id="valor" name="valor" value="{{ v_f }}" required onkeyup="formatarMoeda(this)" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary font-bold text-lg text-slate-700 dark:text-slate-200 transition-all">
                </div>

                <!-- Categoria -->
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Categoria *</label>
                    <select id="categoria_id" name="categoria_id" required 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        <option value="">Escolha a categoria...</option>
                        {% for cat in categorias %}
                            <option value="{{ cat.id }}" data-tipo="{{ cat.tipo }}" {{ (session_get('old').categoria_id ?? lancamento.categoria_id) == cat.id ? 'selected' : '' }}>
                                {{ cat.nome }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- SEÇÃO DE DATAS (AJUSTADA PARA COMPETÊNCIA) -->
                <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
                    <!-- Data da Transação (Quando aconteceu) -->
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Data da Transação *</label>
                        <input type="date" name="data_transacao" value="{{ session_get('old').data_transacao ?? lancamento.data_transacao ?? 'now'|date('Y-m-d') }}" required 
                            class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        <p class="text-[10px] text-slate-400 mt-1 italic">Dia da compra/venda</p>
                    </div>

                    <!-- Data de Vencimento (Data que define o mês no dashboard) -->
                    <div>
                        <label class="block text-[10px] font-black text-primary dark:text-indigo-400 uppercase tracking-widest mb-1">Mês da Fatura / Vencimento *</label>
                        <input type="date" name="data_vencimento" value="{{ session_get('old').data_vencimento ?? lancamento.data_vencimento ?? 'now'|date('Y-m-d') }}" required 
                            class="w-full px-4 py-3 bg-white dark:bg-slate-800 border-2 border-primary/30 dark:border-indigo-500/30 rounded-xl outline-none focus:border-primary text-slate-800 dark:text-white font-bold transition-all">
                        <p class="text-[10px] text-slate-400 mt-1 italic">Mês que será contabilizado</p>
                    </div>

                    <!-- Data de Pagamento -->
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider mb-1">Data de Pagamento</label>
                        <input type="date" name="data_pagamento" value="{{ session_get('old').data_pagamento ?? lancamento.data_pagamento ?? '' }}" 
                            class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        <p class="text-[10px] text-slate-400 mt-1 italic">Dia da saída do dinheiro</p>
                    </div>
                </div>

                <!-- Status -->
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Status do Lançamento *</label>
                    <select name="status" required class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        {% set st = session_get('old').status ?? lancamento.status ?? 'aberto' %}
                        <option value="aberto" {{ st == 'aberto' ? 'selected' : '' }}>Aberto</option>
                        <option value="pendente" {{ st == 'pendente' ? 'selected' : '' }}>Pendente</option>
                        <option value="pago" {{ st == 'pago' ? 'selected' : '' }}>Efetivado / Pago</option>
                    </select>
                </div>

                <!-- Forma de Pagamento -->
                <div>
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Forma de Pagamento *</label>
                    <select name="forma_pagamento" id="forma_pagamento" onchange="toggleCartao()" required
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        {% set fp = session_get('old').forma_pagamento ?? lancamento.forma_pagamento ?? 'pix' %}
                        <option value="pix" {{ fp == 'pix' ? 'selected' : '' }}>PIX</option>
                        <option value="dinheiro" {{ fp == 'dinheiro' ? 'selected' : '' }}>Dinheiro</option>
                        <option value="boleto" {{ fp == 'boleto' ? 'selected' : '' }}>Boleto</option>
                        <option value="cartao_credito" {{ fp == 'cartao_credito' ? 'selected' : '' }}>Cartão de Crédito</option>
                        <option value="transferencia" {{ fp == 'transferencia' ? 'selected' : '' }}>Transferência</option>
                    </select>
                </div>

                <!-- Seletor de Cartão (Dinâmico) -->
                <div id="wrapper_cartao" class="md:col-span-2 {{ (session_get('old').forma_pagamento ?? lancamento.forma_pagamento) == 'cartao_credito' ? '' : 'hidden' }}">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Qual Cartão de Crédito? *</label>
                    <select name="cartao_id" id="cartao_id" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">
                        <option value="">Selecione o cartão usado...</option>
                        {% for cartao in cartoes %}
                            <option value="{{ cartao.id }}" {{ (session_get('old').cartao_id ?? lancamento.cartao_id) == cartao.id ? 'selected' : '' }}>
                                {{ cartao.nome }}
                            </option>
                        {% endfor %}
                    </select>
                    <p class="text-[10px] text-amber-600 dark:text-amber-400 mt-2 font-bold flex items-center gap-1">
                        <i class="ph-bold ph-info"></i> Lembre-se: Ajuste o vencimento acima para o dia de vencimento da fatura deste cartão.
                    </p>
                </div>

                <!-- Observação -->
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Observações Adicionais</label>
                    <textarea name="observacao" rows="3" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-xl outline-none focus:border-primary text-slate-700 dark:text-slate-200 transition-all">{{ session_get('old').observacao ?? lancamento.observacao ?? '' }}</textarea>
                </div>
            </div>

            <!-- BOTÕES -->
            <div class="flex flex-col sm:flex-row justify-end gap-3 mt-10">
                <a href="/lancamentos" class="px-8 py-3 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-darkBorder text-slate-600 dark:text-slate-300 font-medium text-center transition-colors hover:bg-slate-50">Cancelar</a>
                <button type="submit" class="px-10 py-3 rounded-2xl bg-primary text-white font-bold hover:bg-primaryHover transition-all shadow-md shadow-indigo-100 dark:shadow-none">
                    {{ lancamento.id ? 'Atualizar' : 'Gravar' }} Lançamento
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    function formatarMoeda(i) {
        var v = i.value.replace(/\D/g,'');
        v = (v/100).toFixed(2) + '';
        v = v.replace(".", ",");
        v = v.replace(/(\d)(\d{3})(\d{3}),/g, "$1.$2.$3,");
        v = v.replace(/(\d)(\d{3}),/g, "$1.$2,");
        i.value = v;
    }

    function filtrarCategorias() {
        const radio = document.querySelector('input[name="tipo"]:checked');
        if (!radio) return;

        const tipoSelecionado = radio.value;
        const select = document.getElementById('categoria_id');
        const options = select.querySelectorAll('option');

        options.forEach(opt => {
            if (opt.value === "") return;
            const tipoCat = opt.getAttribute('data-tipo');
            if (tipoCat === tipoSelecionado) {
                opt.disabled = false;
                opt.style.display = 'block';
            } else {
                opt.disabled = true;
                opt.style.display = 'none';
                if (opt.selected) select.value = "";
            }
        });
    }

    function toggleCartao() {
        const forma = document.getElementById('forma_pagamento').value;
        const wrapper = document.getElementById('wrapper_cartao');
        const selectCartao = document.getElementById('cartao_id');

        if (forma === 'cartao_credito') {
            wrapper.classList.remove('hidden');
            selectCartao.required = true;
        } else {
            wrapper.classList.add('hidden');
            selectCartao.required = false;
            selectCartao.value = "";
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        filtrarCategorias();
        toggleCartao();
        const v = document.getElementById('valor');
        if (v && v.value) formatarMoeda(v);
    });
</script>
{% endblock %}