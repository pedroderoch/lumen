{% extends "layout.html.twig" %}

{% block title %}Lançamentos Financeiros - Lumen Fintech{% endblock %}

{% block page_title %}Lançamentos{% endblock %}
{% block page_subtitle %}Acompanhe todas as Entradas e Saídas finaneiras do Mês{% endblock %}

{% block content %}

    <!-- NAVEGAÇÃO DE MÊS -->
    <div class="flex items-center justify-between bg-white dark:bg-darkCard p-4 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder mb-6 max-w-2xl mx-auto">
        <a href="/lancamentos?mes={{ mes_anterior }}&ano={{ ano_anterior }}" class="w-10 h-10 flex items-center justify-center rounded-xl text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
            <i class="ph-bold ph-caret-left text-xl"></i>
        </a>
        <div class="text-center px-4">
            <h3 class="text-lg sm:text-xl font-bold text-primary dark:text-indigo-400 capitalize m-0">{{ titulo_mes }}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Extrato Mensal</p>
        </div>
        <a href="/lancamentos?mes={{ mes_proximo }}&ano={{ ano_proximo }}" class="w-10 h-10 flex items-center justify-center rounded-xl text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
            <i class="ph-bold ph-caret-right text-xl"></i>
        </a>
    </div>

    <!-- CARDS DE RESUMO (OS QUATRO) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6">
        <div class="bg-white dark:bg-darkCard p-5 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">A Receber</p>
            <h3 class="text-xl font-bold text-emerald-500">R$ {{ totais.a_receber|number_format(2, ',', '.') }}</h3>
        </div>
        <div class="bg-white dark:bg-darkCard p-5 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Recebido</p>
            <h3 class="text-xl font-bold text-emerald-700">R$ {{ totais.recebido|number_format(2, ',', '.') }}</h3>
        </div>
        <div class="bg-white dark:bg-darkCard p-5 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">A Pagar</p>
            <h3 class="text-xl font-bold text-rose-400">R$ {{ totais.a_pagar|number_format(2, ',', '.') }}</h3>
        </div>
        <div class="bg-white dark:bg-darkCard p-5 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Pago</p>
            <h3 class="text-xl font-bold text-rose-600">R$ {{ totais.pago|number_format(2, ',', '.') }}</h3>
        </div>
    </div>

    <!-- SALDO PROJETADO (RESUMO BONITO) -->
    <div class="bg-gradient-to-r {{ totais.saldo_mes >= 0 ? 'from-emerald-500 to-teal-600' : 'from-rose-500 to-red-600' }} p-6 rounded-3xl shadow-md mb-8 flex flex-col md:flex-row items-center justify-between text-white">
        <div>
            <p class="text-xs font-bold uppercase opacity-80 tracking-widest">Saldo Projetado do Mês</p>
            <h2 class="text-3xl font-black">R$ {{ totais.saldo_mes|number_format(2, ',', '.') }}</h2>
        </div>
        <div class="mt-4 md:mt-0 px-4 py-2 bg-white/20 rounded-2xl backdrop-blur-md border border-white/30 text-sm font-bold">
            {{ totais.saldo_mes >= 0 ? '✓ Orçamento Saudável' : '⚠ Atenção ao Déficit' }}
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div class="flex-1 max-w-md relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                <i class="ph-bold ph-magnifying-glass"></i>
            </div>
            
            <input type="text" id="searchLancamento" placeholder="Filtrar lançamentos..." 
    class="w-full pl-11 pr-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-100 dark:border-darkBorder rounded-2xl text-sm outline-none shadow-sm text-slate-700 dark:text-slate-200 placeholder:text-slate-400">
            
            
        </div>
        <a href="/lancamentos/cadastrar" class="bg-primary hover:bg-primaryHover text-white px-6 py-2.5 rounded-2xl font-bold flex items-center gap-2 transition-all shadow-md text-sm">
            <i class="ph-bold ph-plus"></i> Novo Lançamento
        </a>
    </div>

    <!-- CONTADOR DE RESULTADOS -->
    <div class="mb-4 px-1">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
            Mostrando <span id="visibleCount" class="font-bold text-primary dark:text-indigo-400">{{ lancamentos|length }}</span> de <span class="font-bold">{{ lancamentos|length }}</span> lançamentos encontrados.
        </p>
    </div>

    <!-- TABELA DE LANÇAMENTOS -->
    <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap">
                <thead>
                    <tr class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-500 text-[10px] uppercase tracking-widest border-b border-slate-100 dark:border-darkBorder">
                        <th class="px-6 py-4 font-bold">Venc.</th>
                        <th class="px-6 py-4 font-bold">Descrição</th>
                        <th class="px-6 py-4 font-bold">Categoria</th>
                        <th class="px-6 py-4 font-bold">Favorecido</th>
                        <th class="px-6 py-4 font-bold text-right">Valor</th>
                        <th class="px-6 py-4 font-bold text-center">Status</th>
                        <th class="px-6 py-4 font-bold text-right">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
                    {% for lancamento in lancamentos %}
                        {% set is_ent = lancamento.tipo == 'entrada' %}
                        <tr class="hover:bg-slate-50/30 transition-colors">
                            <td class="px-6 py-4 text-sm font-bold text-slate-700 dark:text-slate-200">{{ lancamento.data_vencimento|date('d/m') }}</td>
                            
                            <td class="px-6 py-4 text-sm font-medium text-slate-800 dark:text-white">{{ lancamento.descricao }}</td>

                            <!-- Categoria com Ícone[cite: 6] -->
                            <td class="px-6 py-4">
                                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-darkBorder">
                                    <i class="ph-fill {{ lancamento.categoria.icone|default('ph-tag') }} text-xs" style="color: {{ lancamento.categoria.cor }}"></i>
                                    <span class="text-[10px] font-bold text-slate-600 dark:text-slate-400 uppercase">{{ lancamento.categoria.nome }}</span>
                                </div>
                            </td>

                            <td class="px-6 py-4 text-xs text-slate-500">{{ lancamento.fornecedor.nome|default('N/D') }}</td>

                            <td class="px-6 py-4 text-right">
                                <span class="text-sm font-black {{ is_ent ? 'text-emerald-600' : 'text-rose-600' }}">
                                    {{ is_ent ? '+' : '-' }} R$ {{ lancamento.valor|number_format(2, ',', '.') }}
                                </span>
                            </td>

                            <td class="px-6 py-4 text-center">
                                {% if lancamento.status == 'pago' %}
                                    <span class="px-2.5 py-1 rounded-full text-[9px] font-bold uppercase bg-emerald-100 text-emerald-700">Efetivado</span>
                                {% else %}
                                    <span class="px-2.5 py-1 rounded-full text-[9px] font-bold uppercase bg-slate-100 text-slate-500">Aberto</span>
                                {% endif %}
                            </td>

                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/lancamentos/editar/{{ lancamento.id }}" class="text-slate-400 hover:text-primary"><i class="ph-bold ph-pencil-simple text-lg"></i></a>
                                    <form action="/lancamentos/excluir/{{ lancamento.id }}" method="POST" class="inline">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" onclick="return confirm('Excluir?')" class="text-slate-400 hover:text-rose-500"><i class="ph-bold ph-trash text-lg"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById('searchLancamento').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const isVisible = text.includes(term);
                
                row.style.display = isVisible ? '' : 'none';
                
                if (isVisible) {
                    visibleCount++;
                }
            });

            // Atualiza o contador na tela
            document.getElementById('visibleCount').innerText = visibleCount;
        });
    </script>
{% endblock %}