{% extends "layout.html.twig" %}

{% block title %}Novo Lançamento - Lumen Fintech{% endblock %}

{% block page_title %}Lançamentos{% endblock %}
{% block page_subtitle %}Registe uma nova entrada ou saída no seu fluxo de caixa{% endblock %}

{% block content %}
    <div class="max-w-4xl mx-auto">
        <form action="/lancamentos/salvar" method="POST" class="space-y-6">
            
            {# Alertas de Erro #}
            {% if session_has('errors') %}
                <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm mb-6">
                    <div class="flex items-center gap-2 font-bold mb-1">
                        <i class="ph-fill ph-warning-circle text-lg"></i>
                        <span>Verifique os erros abaixo:</span>
                    </div>
                    <ul class="list-disc list-inside ml-2">
                        {% for erro in session_get('errors') %}
                            <li>{{ erro }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <!-- BLOCO 1: TIPO E VALOR -->
            <div class="bg-white dark:bg-darkCard p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder text-center">
                
                <!-- Toggle Tipo (Receita / Despesa) -->
                <div class="flex justify-center mb-8">
                    <div class="inline-flex bg-slate-100 dark:bg-slate-800 p-1.5 rounded-2xl">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="tipo" value="despesa" class="peer sr-only" {% if old['tipo'] is not defined or old['tipo'] == 'despesa' %}checked{% endif %} onchange="atualizarCoresTipo()">
                            <div class="px-6 py-2.5 rounded-xl text-sm font-bold text-slate-500 dark:text-slate-400 peer-checked:bg-white dark:peer-checked:bg-slate-700 peer-checked:text-rose-600 dark:peer-checked:text-rose-400 peer-checked:shadow-sm transition-all flex items-center gap-2">
                                <i class="ph-bold ph-arrow-up-right text-lg"></i> Despesa
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="tipo" value="receita" class="peer sr-only" {% if old['tipo'] is defined and old['tipo'] == 'receita' %}checked{% endif %} onchange="atualizarCoresTipo()">
                            <div class="px-6 py-2.5 rounded-xl text-sm font-bold text-slate-500 dark:text-slate-400 peer-checked:bg-white dark:peer-checked:bg-slate-700 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-400 peer-checked:shadow-sm transition-all flex items-center gap-2">
                                <i class="ph-bold ph-arrow-down-left text-lg"></i> Receita
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Input de Valor Gigante -->
                <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2">Valor do Lançamento</p>
                <div class="flex justify-center items-center gap-2 text-slate-800 dark:text-white max-w-xs mx-auto">
                    <span class="text-3xl font-medium text-slate-400" id="sinal_moeda">R$</span>
                    <input type="text" id="valor" name="valor" value="{{ old['valor'] ?? '' }}" required onkeyup="formatarMoeda(this)"
                        class="w-full bg-transparent text-5xl sm:text-6xl font-bold outline-none text-center placeholder:text-slate-200 dark:placeholder:text-slate-700 transition-colors"
                        placeholder="0,00">
                </div>
            </div>

            <!-- BLOCO 2: DADOS PRINCIPAIS -->
            <div class="bg-white dark:bg-darkCard p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-6 flex items-center gap-2 border-b border-slate-50 dark:border-darkBorder pb-4">
                    <i class="ph-fill ph-text-t text-primary"></i> Detalhes do Lançamento
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Descrição -->
                    <div class="md:col-span-2">
                        <label for="descricao" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Descrição <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-pencil-line text-lg"></i>
                            </div>
                            <input type="text" id="descricao" name="descricao" value="{{ old['descricao'] ?? '' }}" required
                                class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-slate-400"
                                placeholder="Ex: Conta de Luz, Compra no Supermercado...">
                        </div>
                    </div>

                    <!-- Data de Vencimento -->
                    <div>
                        <label for="data_vencimento" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Data de Vencimento <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-calendar-blank text-lg"></i>
                            </div>
                            <input type="date" id="data_vencimento" name="data_vencimento" value="{{ old['data_vencimento'] ?? 'now'|date('Y-m-d') }}" required
                                class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                        </div>
                    </div>

                    <!-- Fornecedor / Cliente -->
                    <div>
                        <label for="fornecedor_id" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Fornecedor / Cliente</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-buildings text-lg"></i>
                            </div>
                            <select id="fornecedor_id" name="fornecedor_id" class="w-full pl-10 pr-10 py-3 appearance-none bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all cursor-pointer">
                                <option value="">Selecione... (Opcional)</option>
                                {% for fornecedor in fornecedores %}
                                    <option value="{{ fornecedor.id }}" {% if old['fornecedor_id'] is defined and old['fornecedor_id'] == fornecedor.id %}selected{% endif %}>{{ fornecedor.nome }}</option>
                                {% endfor %}
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400"><i class="ph-bold ph-caret-down"></i></div>
                        </div>
                    </div>

                    <!-- Categoria -->
                    <div class="md:col-span-2">
                        <label for="categoria_id" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Categoria <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-tag text-lg"></i>
                            </div>
                            <select id="categoria_id" name="categoria_id" required class="w-full pl-10 pr-10 py-3 appearance-none bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all cursor-pointer">
                                <option value="" disabled selected>Escolha uma categoria...</option>
                                {% for categoria in categorias %}
                                    <option value="{{ categoria.id }}" {% if old['categoria_id'] is defined and old['categoria_id'] == categoria.id %}selected{% endif %}>{{ categoria.nome }}</option>
                                {% endfor %}
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400"><i class="ph-bold ph-caret-down"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BLOCO 3: PAGAMENTO -->
            <div class="bg-white dark:bg-darkCard p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-6 flex items-center gap-2 border-b border-slate-50 dark:border-darkBorder pb-4">
                    <i class="ph-fill ph-wallet text-primary"></i> Confirmação de Pagamento
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Status do Pagamento (Toggle) -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Status <span class="text-rose-500">*</span></label>
                        <div class="flex flex-wrap gap-4">
                            <!-- Pendente -->
                            <label class="relative flex-1 sm:flex-none flex items-center gap-3 p-3 border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 dark:has-[:checked]:bg-amber-500/10">
                                <input type="radio" name="status" value="pendente" class="w-4 h-4 text-amber-600 focus:ring-amber-500 dark:bg-slate-700 dark:border-slate-600" 
                                       {% if old['status'] is not defined or old['status'] == 'pendente' %}checked{% endif %} onchange="toggleDataPagamento()">
                                <span class="text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center gap-2">
                                    <i class="ph-bold ph-clock text-amber-500"></i> Pendente
                                </span>
                            </label>

                            <!-- Pago -->
                            <label class="relative flex-1 sm:flex-none flex items-center gap-3 p-3 border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-500/10">
                                <input type="radio" name="status" value="pago" class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-700 dark:border-slate-600" 
                                       {% if old['status'] is defined and old['status'] == 'pago' %}checked{% endif %} onchange="toggleDataPagamento()">
                                <span class="text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center gap-2">
                                    <i class="ph-bold ph-check-circle text-emerald-500"></i> Foi Pago / Recebido
                                </span>
                            </label>
                        </div>
                    </div>

                    <!-- Forma de Pagamento -->
                    <div>
                        <label for="forma_pagamento" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Forma de Pagamento</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-credit-card text-lg"></i>
                            </div>
                            <select id="forma_pagamento" name="forma_pagamento" class="w-full pl-10 pr-10 py-3 appearance-none bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all cursor-pointer">
                                <option value="PIX">PIX</option>
                                <option value="Cartão de Crédito">Cartão de Crédito</option>
                                <option value="Cartão de Débito">Cartão de Débito</option>
                                <option value="Dinheiro">Dinheiro</option>
                                <option value="Boleto">Boleto Bancário</option>
                                <option value="Transferência">Transferência Bancária</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400"><i class="ph-bold ph-caret-down"></i></div>
                        </div>
                    </div>

                    <!-- Conta Bancária -->
                    <div>
                        <label for="conta_id" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Conta Bancária / Carteira</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-bank text-lg"></i>
                            </div>
                            <select id="conta_id" name="conta_id" class="w-full pl-10 pr-10 py-3 appearance-none bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all cursor-pointer">
                                <option value="" disabled selected>Selecione a conta...</option>
                                {% for conta in contas %}
                                    <option value="{{ conta.id }}">{{ conta.nome }}</option>
                                {% endfor %}
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400"><i class="ph-bold ph-caret-down"></i></div>
                        </div>
                    </div>

                    <!-- Data de Pagamento (Condicional via JS) -->
                    <div id="box_data_pagamento" class="hidden">
                        <label for="data_pagamento" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Data que foi pago/recebido</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="ph ph-calendar-check text-lg"></i>
                            </div>
                            <input type="date" id="data_pagamento" name="data_pagamento" value="{{ old['data_pagamento'] ?? 'now'|date('Y-m-d') }}"
                                class="w-full pl-10 pr-4 py-3 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 rounded-xl text-emerald-800 dark:text-emerald-200 outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all">
                        </div>
                    </div>
                </div>
            </div>

            <!-- BOTÕES DE AÇÃO -->
            <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-6">
                <a href="/lancamentos" class="px-6 py-3 rounded-2xl font-medium text-slate-600 dark:text-slate-400 bg-white dark:bg-darkCard hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors text-center shadow-sm">
                    Cancelar
                </a>
                <button type="submit" class="px-8 py-3 rounded-2xl font-bold text-white bg-primary hover:bg-primaryHover shadow-sm shadow-indigo-200 dark:shadow-none transition-colors flex justify-center items-center gap-2">
                    <i class="ph-bold ph-floppy-disk text-lg"></i> Gravar Lançamento
                </button>
            </div>
        </form>
    </div>

    <!-- SCRIPTS -->
    <script>
        // Formatar Moeda BR
        function formatarMoeda(i) {
            var v = i.value.replace(/\D/g,'');
            v = (v/100).toFixed(2) + '';
            v = v.replace(".", ",");
            v = v.replace(/(\d)(\d{3})(\d{3}),/g, "$1.$2.$3,");
            v = v.replace(/(\d)(\d{3}),/g, "$1.$2,");
            i.value = v;
        }

        // Alterar cor do valor gigante com base na Receita/Despesa
        function atualizarCoresTipo() {
            const inputValor = document.getElementById('valor');
            const tipoDespesa = document.querySelector('input[name="tipo"][value="despesa"]').checked;
            
            if (tipoDespesa) {
                inputValor.classList.remove('text-emerald-500');
                inputValor.classList.add('text-rose-500');
            } else {
                inputValor.classList.remove('text-rose-500');
                inputValor.classList.add('text-emerald-500');
            }
        }

        // Exibir/Ocultar campo de Data de Pagamento
        function toggleDataPagamento() {
            const statusPago = document.querySelector('input[name="status"][value="pago"]').checked;
            const boxData = document.getElementById('box_data_pagamento');
            
            if (statusPago) {
                boxData.classList.remove('hidden');
                boxData.classList.add('block');
            } else {
                boxData.classList.add('hidden');
                boxData.classList.remove('block');
            }
        }

        // Executar no carregamento
        document.addEventListener("DOMContentLoaded", function() {
            atualizarCoresTipo();
            toggleDataPagamento();
        });
    </script>
{% endblock %}
