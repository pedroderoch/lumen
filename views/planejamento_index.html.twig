{% extends "layout.html.twig" %}

{% block title %}Planejamento Mensal - Lumen Fintech{% endblock %}

{% block page_title %}Planejamento{% endblock %}
{% block page_subtitle %}Crie o seu orçamento e defina limites de gastos para o mês{% endblock %}

{% block content %}

    <form action="/planejamento/salvar" method="POST" id="form-planejamento">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <!-- ENTRADA DE DADOS -->
        <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 sm:p-8 mb-8 relative overflow-hidden">
            <!-- Fundo Decorativo -->
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 dark:bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">Seus dados</h3>
                <p class="text-sm text-slate-400 dark:text-slate-500 mb-6">Informe seu salário para calcularmos suas metas automaticamente</p>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                    <!-- Salário -->
                    <div>
                        <label for="salario" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Salário mensal
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 text-sm font-medium">R$</span>
                            <input
                                type="text"
                                id="salario"
                                name="salario"
                                inputmode="decimal"
                                placeholder="0,00"
                                {# value="{{ planejamento.salario ?? '' }}" #}
                                value="{{ 5850.00 }}"
                                class="w-full pl-12 pr-4 py-3 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-slate-400"
                            >
                        </div>
                    </div>

                    <!-- Caixinha vinculada à Reserva de Emergência -->
                    <div>
                        <label for="caixinha_reserva_id" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Caixinha da reserva de emergência
                        </label>
                        <select
                            id="caixinha_reserva_id"
                            name="caixinha_reserva_id"
                            class="w-full py-3 px-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                        >
                            <option value="">Nenhuma — não acompanhar</option>
                            {% for caixinha in caixinhas %}
                                <option
                                    value="{{ caixinha.id }}"
                                    data-valor-atual="{{ caixinha.valor_atual }}"
                                    {% if planejamento.caixinha_reserva_id == caixinha.id %}selected{% endif %}
                                >
                                    {{ caixinha.nome }} (R$ {{ caixinha.valor_atual|number_format(2, ',', '.') }})
                                </option>
                            {% endfor %}
                        </select>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1.5">O valor atual da caixinha é buscado automaticamente</p>
                    </div>

                </div>

                <!-- Total acumulado em todas as caixinhas (Liberdade Financeira) -->
                <div class="mt-5 flex items-center gap-3 bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-100 dark:border-indigo-500/20 rounded-2xl px-5 py-4">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/15 flex items-center justify-center flex-shrink-0">
                        <i class="ph-fill ph-piggy-bank text-lg text-indigo-500"></i>
                    </div>
                    <div>
                        <p class="text-xs text-indigo-500/80 dark:text-indigo-300/80 font-medium">Patrimônio total (soma de todas as caixinhas)</p>
                        <p class="text-lg font-bold text-indigo-600 dark:text-indigo-300">
                            R$ {{ total_caixinhas|default(0)|number_format(2, ',', '.') }}
                        </p>
                    </div>
                </div>

                {% if caixinhas is empty %}
                    <div class="mt-5 flex items-center gap-2 text-sm text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 rounded-2xl px-4 py-3">
                        <i class="ph-fill ph-info"></i>
                        Você ainda não tem caixinhas cadastradas.
                        <a href="/caixinhas/cadastrar" class="font-semibold underline">Criar uma agora</a>
                    </div>
                {% endif %}
            </div>
        </div>

                <!-- METAS CALCULADAS -->
        <div id="metas-container" class="hidden" data-total-caixinhas="{{ total_caixinhas|default(0) }}">

            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-bold text-slate-800 dark:text-white">Suas metas calculadas</h3>
                <button type="submit" class="text-sm font-semibold text-primary hover:text-primaryHover transition-colors flex items-center gap-1.5">
                    <i class="ph-bold ph-floppy-disk"></i>
                    Salvar planejamento
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

                <!-- CARD: Patrimônio p/ Liberdade Financeira -->
                <div class="meta-card bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-2xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center">
                            <i class="ph-fill ph-crown-simple text-xl text-indigo-500"></i>
                        </div>
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Longo prazo</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Patrimônio para viver de renda</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mb-3" data-meta="liberdade">R$ 0,00</p>

                    <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden mb-2">
                        <div class="h-full rounded-full bg-indigo-500 transition-all duration-700" data-bar="liberdade" style="width:0%"></div>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400 dark:text-slate-500">Você tem <span class="font-semibold text-slate-600 dark:text-slate-300" data-atual="liberdade">R$ 0,00</span></span>
                        <span class="font-semibold text-indigo-500" data-pct="liberdade">0%</span>
                    </div>
                </div>

                <!-- CARD: Investimento mensal -->
                <div class="meta-card bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center">
                            <i class="ph-fill ph-trend-up text-xl text-emerald-500"></i>
                        </div>
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Mensal</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Investir por mês p/ chegar à meta</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mb-3" data-meta="investir_mensal">R$ 0,00</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500">20% do seu salário, todo mês, sem falhar</p>
                </div>

                <!-- CARD: Reserva de emergência -->
                <div class="meta-card bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-2xl bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                            <i class="ph-fill ph-shield-check text-xl text-amber-500"></i>
                        </div>
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Segurança</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Reserva de emergência (6x salário)</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mb-3" data-meta="reserva">R$ 0,00</p>

                    <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden mb-2">
                        <div class="h-full rounded-full bg-amber-500 transition-all duration-700" data-bar="reserva" style="width:0%"></div>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400 dark:text-slate-500">Você tem <span class="font-semibold text-slate-600 dark:text-slate-300" data-atual="reserva">R$ 0,00</span></span>
                        <span class="font-semibold text-amber-500" data-pct="reserva">0%</span>
                    </div>
                </div>

                <!-- CARD: Lazer -->
                <div class="meta-card bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-2xl bg-rose-50 dark:bg-rose-500/10 flex items-center justify-center">
                            <i class="ph-fill ph-confetti text-xl text-rose-500"></i>
                        </div>
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Mensal</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Limite para lazer</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mb-3" data-meta="lazer">R$ 0,00</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500">30% do salário, sem culpa</p>
                </div>

                <!-- CARD: Gastos Fixos -->
                <div class="meta-card bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 relative overflow-hidden">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-2xl bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center">
                            <i class="ph-fill ph-house-line text-xl text-sky-500"></i>
                        </div>
                        <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Mensal</span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">Limite máximo p/ gastos fixos</p>
                    <p class="text-2xl font-bold text-slate-800 dark:text-white mb-3" data-meta="fixos">R$ 0,00</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500">50% do salário (aluguel, contas, etc)</p>
                </div>

            </div>
        </div>

        <!-- ESTADO VAZIO -->
        <div id="estado-vazio" class="text-center py-16">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
                <i class="ph-fill ph-calculator text-3xl text-slate-400"></i>
            </div>
            <p class="text-slate-500 dark:text-slate-400 font-medium">Informe seu salário acima</p>
            <p class="text-sm text-slate-400 dark:text-slate-500">Suas metas serão calculadas automaticamente</p>
        </div>

    </form>

    <!-- SCRIPTS MÁGICOS DE CÁLCULO -->
    <script>
        (function () {
            const inputSalario  = document.getElementById('salario');
            const selectReserva = document.getElementById('caixinha_reserva_id');
            const container     = document.getElementById('metas-container');
            const estadoVazio   = document.getElementById('estado-vazio');
            const totalCaixinhas = parseFloat(container.dataset.totalCaixinhas || '0');

            function parseValor(str) {
                if (!str) return 0;
                // aceita "1.234,56" ou "1234.56" ou "1234,56"
                const limpo = str.toString()
                    .replace(/[^\d,.-]/g, '')
                    .replace(/\.(?=\d{3}(\D|$))/g, '') // remove ponto de milhar
                    .replace(',', '.');
                const num = parseFloat(limpo);
                return isNaN(num) ? 0 : num;
            }

            function formatarMoeda(valor) {
                return 'R$ ' + valor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function setMeta(chave, valor) {
                const el = document.querySelector(`[data-meta="${chave}"]`);
                if (el) el.textContent = formatarMoeda(valor);
            }

            function valorAtualDoSelect(select) {
                if (!select || !select.value) return 0;
                const opcao = select.options[select.selectedIndex];
                return parseFloat(opcao.dataset.valorAtual || '0');
            }

            function setProgresso(chave, atual, meta) {
                const pct = meta > 0 ? Math.min((atual / meta) * 100, 100) : 0;
                const bar = document.querySelector(`[data-bar="${chave}"]`);
                const pctEl = document.querySelector(`[data-pct="${chave}"]`);
                const atualEl = document.querySelector(`[data-atual="${chave}"]`);

                if (bar) bar.style.width = pct.toFixed(1) + '%';
                if (pctEl) pctEl.textContent = pct.toFixed(0) + '%';
                if (atualEl) atualEl.textContent = formatarMoeda(atual);
            }

            function calcular() {
                const salario = parseValor(inputSalario.value);

                if (salario <= 0) {
                    container.classList.add('hidden');
                    estadoVazio.classList.remove('hidden');
                    return;
                }

                container.classList.remove('hidden');
                estadoVazio.classList.add('hidden');

                const metaLiberdade   = salario * 120;
                const investirMensal  = salario * 0.2;
                const metaReserva     = salario * 6;
                const lazer           = salario * 0.3;
                const fixos           = salario / 2;

                setMeta('liberdade', metaLiberdade);
                setMeta('investir_mensal', investirMensal);
                setMeta('reserva', metaReserva);
                setMeta('lazer', lazer);
                setMeta('fixos', fixos);

                // Reserva compara com a caixinha selecionada
                const atualReserva = valorAtualDoSelect(selectReserva);
                setProgresso('reserva', atualReserva, metaReserva);

                // Liberdade financeira compara com a soma de TODAS as caixinhas
                setProgresso('liberdade', totalCaixinhas, metaLiberdade);
            }

            // Máscara simples de moeda ao digitar
            function aplicarMascara(input) {
                input.addEventListener('input', function () {
                    let v = this.value.replace(/\D/g, '');
                    v = (parseInt(v || '0', 10) / 100).toFixed(2) + '';
                    v = v.replace('.', ',');
                    v = v.replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.');
                    this.value = v;
                    calcular();
                });
            }

            aplicarMascara(inputSalario);
            selectReserva.addEventListener('change', calcular);

            // Calcula ao carregar (caso já existam valores salvos)
            calcular();
        })();
    </script>
{% endblock %}
