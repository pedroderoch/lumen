{% extends "layout.html.twig" %}

{% block title %}Usuários do Sistema - Lumen Fintech{% endblock %}

{% block page_title %}Usuários{% endblock %}
{% block page_subtitle %}Faça a gestão dos acessos e permissões do sistema{% endblock %}

{% block content %}
    
    <!-- HEADER DA PÁGINA -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <!-- Barra de Pesquisa -->
        <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                <i class="ph-bold ph-magnifying-glass text-lg"></i>
            </div>
            <input type="text" placeholder="Procurar por nome ou e-mail..." 
                class="w-full pl-11 pr-4 py-3 bg-white dark:bg-darkCard border border-slate-100 dark:border-darkBorder rounded-2xl text-slate-800 dark:text-slate-200 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm">
        </div>

        <!-- Botão Novo Usuário -->
        <div class="flex-shrink-0">
            <a href="/usuarios/cadastrar" class="w-full sm:w-auto bg-primary hover:bg-primaryHover text-white px-6 py-3 rounded-2xl font-medium flex items-center justify-center gap-2 transition-all shadow-sm shadow-indigo-200 dark:shadow-none">
                <i class="ph-bold ph-plus text-lg"></i>
                Novo Usuário
            </a>
        </div>
    </div>

    {# Alertas de Sucesso/Erro #}
    {% if session_has('success') %}
        <div class="mb-8 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2 font-medium shadow-sm">
            <i class="ph-fill ph-check-circle text-lg"></i>
            {{ session_get('success') }}
        </div>
    {% endif %}

    {% if session_has('errors') %}
        <div class="mb-8 p-4 rounded-2xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm flex items-center gap-2 font-medium shadow-sm">
            <i class="ph-fill ph-warning-circle text-lg"></i>
            {{ session_get('errors')[0] }}
        </div>
    {% endif %}


    {# Listagem de Usuários #}
    {% if usuarios is empty %}
        <!-- Empty State -->
        <div class="bg-white dark:bg-darkCard rounded-3xl border border-slate-100 dark:border-darkBorder border-dashed p-12 flex flex-col items-center justify-center text-center">
            <div class="w-20 h-20 bg-indigo-50 dark:bg-indigo-500/10 rounded-full flex items-center justify-center mb-4 text-primary dark:text-indigo-400">
                <i class="ph-fill ph-users text-4xl"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">Nenhum usuário encontrado</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Comece adicionando acessos para a sua equipa.</p>
            <a href="/usuarios/cadastrar" class="px-6 py-2.5 bg-primary hover:bg-primaryHover text-white rounded-xl font-medium transition-colors flex items-center gap-2">
                <i class="ph-bold ph-plus"></i> Criar Primeiro Usuário
            </a>
        </div>
    {% else %}
        <!-- Grid de Cards de Usuários -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            {% for usuario in usuarios %}
                <div class="bg-white dark:bg-darkCard rounded-3xl shadow-sm border border-slate-100 dark:border-darkBorder p-6 flex flex-col hover:shadow-md transition-shadow relative group">
                    
                    <!-- Header do Card -->
                    <div class="flex justify-between items-start mb-5">
                        <div class="flex items-center gap-4">
                            <!-- Avatar -->
                            {% if usuario.foto %}
                                <img src="/uploads/{{ usuario.foto }}" alt="Foto de {{ usuario.nome }}" class="w-14 h-14 rounded-full object-cover border-2 border-slate-50 dark:border-slate-800 shadow-sm">
                            {% else %}
                                <div class="w-14 h-14 rounded-full flex items-center justify-center text-xl font-bold shadow-sm
                                    {% if usuario.nivel == 'admin' %} bg-indigo-100 dark:bg-indigo-500/20 text-primary dark:text-indigo-400
                                    {% else %} bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 {% endif %}">
                                    <i class="ph-fill ph-user"></i>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Dropdown Menu de Opções -->
                        <div class="relative dropdown-container">
                            <button onclick="toggleDropdown({{ usuario.id }})" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1">
                                <i class="ph-bold ph-dots-three-vertical text-xl"></i>
                            </button>
                            
                            <div id="dropdown-{{ usuario.id }}" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 z-20 overflow-hidden">
                                <a href="/usuarios/editar/{{ usuario.id }}" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                                    <i class="ph ph-pencil-simple"></i> Editar Usuário
                                </a>
                                <form action="/usuarios/excluir/{{ usuario.id }}" method="POST" onsubmit="return confirm('Tem certeza que deseja remover o acesso deste usuário?');" class="m-0">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="w-full flex items-center gap-2 px-4 py-3 text-sm text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors text-left">
                                        <i class="ph ph-trash"></i> Excluir Acesso
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Informações Principais -->
                    <div class="mb-4 flex-1">
                        <h3 class="font-bold text-lg text-slate-800 dark:text-white leading-tight mb-1">{{ usuario.nome }}</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1.5 truncate">
                            <i class="ph-fill ph-envelope-simple"></i> {{ usuario.email }}
                        </p>
                        <p class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1.5 truncate">
                            <i class="ph-fill ph-power"></i> {{ usuario.situacao.nome }}
                        </p>
                    </div>
                    
                    <!-- Footer do Card (Nível de Acesso) -->
                    <div class="pt-4 border-t border-slate-50 dark:border-darkBorder flex items-center justify-between">
                        {% if usuario.nivel == 'admin' %}
                            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 text-primary dark:text-indigo-400 text-xs font-bold uppercase tracking-wide">
                                <i class="ph-fill ph-shield-check text-sm"></i> Administrador
                            </div>
                        {% else %}
                            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold uppercase tracking-wide">
                                <i class="ph-fill ph-user text-sm"></i> Usuário Padrão
                            </div>
                        {% endif %}
                        
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">ID: #{{ usuario.id }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Paginação -->
        {% set total_pages = total_pages|default(1) %}
        {% set current_page = current_page|default(1) %}
        
        {% if total_pages > 1 %}
        <div class="flex justify-center w-full mt-4 pb-4">
            <nav class="flex items-center gap-1 bg-white dark:bg-darkCard p-1.5 rounded-2xl shadow-sm border border-slate-100 dark:border-darkBorder">
                <a href="?page={{ current_page - 1 }}" class="p-2 rounded-xl text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors {% if current_page <= 1 %}opacity-50 cursor-not-allowed pointer-events-none{% endif %}">
                    <i class="ph-bold ph-caret-left text-lg"></i>
                </a>
                <div class="flex items-center gap-1 px-2">
                    {% for page in 1..total_pages %}
                        <a href="?page={{ page }}" class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all {% if page == current_page %} bg-primary text-white shadow-sm shadow-indigo-200 dark:shadow-none {% else %} text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 {% endif %}">
                            {{ page }}
                        </a>
                    {% endfor %}
                </div>
                <a href="?page={{ current_page + 1 }}" class="p-2 rounded-xl text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors {% if current_page >= total_pages %}opacity-50 cursor-not-allowed pointer-events-none{% endif %}">
                    <i class="ph-bold ph-caret-right text-lg"></i>
                </a>
            </nav>
        </div>
        {% endif %}
    {% endif %}

    <!-- SCRIPTS DE INTERAÇÃO -->
    <script>
        function toggleDropdown(id) {
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
                if(el.id !== `dropdown-${id}`) el.classList.add('hidden');
            });
            const dropdown = document.getElementById(`dropdown-${id}`);
            dropdown.classList.toggle('hidden');
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown-container')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(el => el.classList.add('hidden'));
            }
        });
    </script>
{% endblock %}